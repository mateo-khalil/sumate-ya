---
/**
 * Topbar — barra de navegación compartida, siempre visible (sticky top-0).
 *
 * Decision Context:
 * - Adaptada para tema claro y oscuro usando CSS variables del design system.
 * - "Crear torneo" y CaptainBadge están en DynamicNavActions (isla React) porque
 *   requieren verificar capitanía en cliente; solo se muestran si el usuario es capitán (F9).
 * - NotificationBell en DynamicNavActions para invitaciones de equipo accesibles desde navbar.
 * - Botones de acción siempre en naranja (color-primary) para identidad FIFA.
 * - Tab activa: se calcula con Astro.url.pathname y se marca con `aria-current="page"` +
 *   clase `.is-active` (subrayado naranja). "Partidos & Torneos" cubre /partidos y /torneos.
 * - Menú de cuenta: las acciones de usuario (ver perfil, configuración, tema, cerrar sesión)
 *   se agruparon en un único desplegable detrás del nombre para descargar la barra, que estaba
 *   sobrecargada con ~9 elementos sueltos. El toggle de tema vive ahora dentro de este menú
 *   (en "configuración"/preferencias) en vez de ocupar un botón fijo en la barra para usuarios
 *   logueados. Los visitantes anónimos sí conservan el toggle visible (no tienen menú de cuenta).
 * - El desplegable usa un <script> vanilla (no una isla React extra) para abrir/cerrar:
 *   click en el trigger, click fuera y Escape lo cierran. Más liviano que hidratar React.
 * - Previously fixed bugs:
 *   - Colores hardcodeados oscuros causaban problemas en tema claro → ahora usa var(--color-*)
 *   - "Crear torneo" aparecía para todos → movido a DynamicNavActions que filtra por capitanía
 *   - No había indicador de tab activa y la barra estaba saturada → tab activa + menú de cuenta.
 */

import { Volleyball, ChevronDown, UserRound, Settings, LogOut } from 'lucide-react';
import { ThemeToggle } from '@/components/ui/ThemeToggle';
import { DynamicNavActions } from './DynamicNavActions';
import ClubTopbar from '../panel-club/ClubTopbar.astro';

interface Props {
  user?: {
    id: string;
    displayName?: string | null;
    email?: string | null;
    role?: string | null;
  } | null;
}

const { user } = Astro.props;
const nombre = user?.displayName || user?.email || '';
const email = user?.email || '';
const isPlayer = user?.role === 'player';
const isClubAdmin = user?.role === 'club_admin';

// Tab activa: una ruta cuenta como activa si es exacta o si es un sub-path (p.ej. /torneos/123).
const pathname = Astro.url.pathname;
const matchesPath = (...prefixes: string[]) =>
  prefixes.some((p) => pathname === p || pathname.startsWith(`${p}/`));
const partidosActive = matchesPath('/partidos', '/torneos');
const equiposActive = matchesPath('/equipos');
const rankingActive = matchesPath('/leaderboard');
const settingsHref = isClubAdmin ? '/panel-club/configuracion' : '/ajustes';
---

{/* Dispatch por rol: un club_admin ve SIEMPRE la barra de club (ClubTopbar) en cualquier
    página que use este Topbar compartido (detalle de torneo, perfil, listados, etc.), no la
    barra de jugador. Antes el club_admin veía la navbar de jugador fuera del panel-club. */}
{isClubAdmin ? (
  <ClubTopbar user={user} currentPath={pathname} />
) : (
<nav class="shared-topbar">
  <div class="topbar-inner">

    <!-- Brand -->
    <a href="/partidos" class="topbar-brand">
      <span class="topbar-ball"><Volleyball size={20} strokeWidth={2} aria-hidden="true" /></span>
      <span class="topbar-name">SUMATE YA</span>
    </a>

    <!-- Links centrales -->
    <div class="topbar-center">
      <a
        href="/partidos"
        class:list={['nav-link', { 'is-active': partidosActive }]}
        aria-current={partidosActive ? 'page' : undefined}
      >Partidos &amp; Torneos</a>
      {user && (
        <a
          href="/equipos"
          class:list={['nav-link', { 'is-active': equiposActive }]}
          aria-current={equiposActive ? 'page' : undefined}
        >Equipos</a>
      )}
      <a
        href="/leaderboard"
        class:list={['nav-link', { 'is-active': rankingActive }]}
        aria-current={rankingActive ? 'page' : undefined}
      >Ranking</a>
    </div>

    <!-- Acciones -->
    <div class="topbar-actions">
      {user ? (
        <>
          {isPlayer && (
            <a href="/partidos/crear" class="btn-action">+ Crear partido</a>
          )}
          {isClubAdmin && (
            <a href="/panel-club" class="btn-action btn-action--club">Panel Club</a>
          )}
          {/* Crear torneo (solo capitanes) + CaptainBadge + NotificationBell */}
          {isPlayer && (
            <DynamicNavActions client:load userId={user.id} />
          )}

          {/* Menú de cuenta: agrupa ver perfil, configuración, tema y cerrar sesión */}
          <div class="account" data-account-menu>
            <button
              type="button"
              class="user-badge"
              data-account-trigger
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="Abrir menú de cuenta"
            >
              <span class="user-avatar"><UserRound size={16} strokeWidth={2} aria-hidden="true" /></span>
              <span class="user-name">{nombre}</span>
              <ChevronDown className="account-caret" size={14} strokeWidth={2.5} aria-hidden="true" />
            </button>

            <div class="account-menu" data-account-dropdown role="menu" hidden>
              <div class="account-head">
                <span class="account-head-name">{nombre}</span>
                {email && <span class="account-head-email">{email}</span>}
              </div>

              {isPlayer && (
                <a href="/perfil" class="account-item" role="menuitem">
                  <UserRound size={15} strokeWidth={2} aria-hidden="true" />
                  <span>Ver mi perfil</span>
                </a>
              )}

              <a href={settingsHref} class="account-item" role="menuitem">
                <Settings size={15} strokeWidth={2} aria-hidden="true" />
                <span>Configuración</span>
              </a>

              <div class="account-theme">
                <span class="account-theme-label">Tema</span>
                <ThemeToggle client:load />
              </div>

              <div class="account-sep" role="separator"></div>

              <form method="POST" action="/api/auth/logout">
                <button type="submit" class="account-item account-item--danger" role="menuitem">
                  <LogOut size={15} strokeWidth={2} aria-hidden="true" />
                  <span>Cerrar sesión</span>
                </button>
              </form>
            </div>
          </div>
        </>
      ) : (
        <>
          <ThemeToggle client:load />
          {/* data-testid is a stable hook for e2e (TournamentDetailPage / topbar specs):
              pages render the inline "Iniciar sesion para anotar" CTA too, so scoping
              by class alone was brittle after the topbar was extracted into this shared
              component (class shared-topbar, not the old .topbar). */}
          <a href="/login" class="btn-login" data-testid="topbar-login-link">Iniciar Sesión</a>
        </>
      )}
    </div>
  </div>
  <div class="topbar-accent" aria-hidden="true"></div>
</nav>
)}

<script>
  // Menú de cuenta: abrir/cerrar el desplegable detrás del nombre del usuario.
  // Vanilla (sin isla React) para mantener la barra liviana. Cierra al hacer click
  // fuera o con Escape; clicks dentro (p.ej. el toggle de tema) no lo cierran.
  const menu = document.querySelector<HTMLElement>('[data-account-menu]');
  const trigger = menu?.querySelector<HTMLButtonElement>('[data-account-trigger]');
  const dropdown = menu?.querySelector<HTMLElement>('[data-account-dropdown]');

  if (menu && trigger && dropdown) {
    const setOpen = (open: boolean) => {
      dropdown.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(Boolean(dropdown.hidden));
    });

    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .shared-topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 15, 31, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.2s, border-color 0.2s;
  }

  /* Tema claro */
  :global(html.light) .shared-topbar {
    background: rgba(255, 255, 255, 0.94);
    border-bottom-color: rgba(0, 0, 0, 0.09);
  }

  .topbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 54px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Brand */
  .topbar-brand {
    display: flex; align-items: center; gap: 0.45rem;
    text-decoration: none; flex-shrink: 0;
  }
  .topbar-ball { color: hsl(35 100% 55%); line-height: 1; }
  .topbar-name {
    font-family: 'Bebas Neue', 'Barlow Condensed', sans-serif;
    font-size: 1.05rem; letter-spacing: 0.05em;
    color: hsl(210 20% 94%);
    transition: color 0.2s;
  }
  :global(html.light) .topbar-name { color: hsl(220 72% 12%); }

  /* Links */
  .topbar-center { display: flex; align-items: center; gap: 0.2rem; flex: 1; }
  .nav-link {
    position: relative;
    padding: 0.3rem 0.6rem; border-radius: 6px;
    font-size: 0.82rem; font-weight: 500;
    color: hsl(215 20% 65%);
    text-decoration: none; white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover { color: hsl(215 20% 90%); background: rgba(255,255,255,0.07); }
  :global(html.light) .nav-link { color: hsl(220 20% 35%); }
  :global(html.light) .nav-link:hover { color: hsl(220 72% 10%); background: rgba(0,0,0,0.05); }

  /* Tab activa: texto naranja + subrayado */
  .nav-link.is-active { color: hsl(35 100% 62%); font-weight: 600; }
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0.6rem; right: 0.6rem; bottom: 0;
    height: 2px; border-radius: 2px;
    background: var(--color-primary, hsl(35 100% 48%));
  }
  .nav-link.is-active:hover { background: transparent; }
  :global(html.light) .nav-link.is-active { color: hsl(35 100% 40%); }

  /* Acciones */
  .topbar-actions { display: flex; align-items: center; gap: 0.45rem; flex-shrink: 0; }

  .btn-action {
    padding: 0.35rem 0.75rem; border-radius: 7px;
    font-size: 0.78rem; font-weight: 700;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none; white-space: nowrap;
    transition: opacity 0.15s;
  }
  .btn-action:hover { opacity: 0.88; }

  /* Panel Club también naranja — diferente shade */
  .btn-action--club {
    background: hsl(35 80% 40%);
  }

  /* Account menu */
  .account { position: relative; flex-shrink: 0; }

  /* Trigger (mantiene la clase .user-badge para compatibilidad de selectores e2e) */
  .user-badge {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.25rem 0.5rem 0.25rem 0.35rem; border-radius: 999px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
    font-size: 0.78rem; color: hsl(215 20% 72%); white-space: nowrap;
    cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .user-badge:hover { background: rgba(255,255,255,0.12); color: hsl(215 20% 90%); }
  .user-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 50%;
    background: rgba(246,164,0,0.16); color: hsl(35 100% 62%); flex-shrink: 0;
  }
  .user-name { max-width: 120px; overflow: hidden; text-overflow: ellipsis; }
  .account-caret { color: hsl(215 20% 55%); transition: transform 0.15s; }
  .user-badge[aria-expanded='true'] .account-caret { transform: rotate(180deg); }
  :global(html.light) .user-badge {
    background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.1); color: hsl(220 20% 35%);
  }
  :global(html.light) .user-badge:hover { background: rgba(0,0,0,0.07); color: hsl(220 72% 12%); }

  /* Dropdown */
  .account-menu {
    position: absolute; top: calc(100% + 10px); right: 0;
    min-width: 220px;
    background: var(--color-card, hsl(220 55% 11%));
    border: 1px solid var(--color-border, hsl(220 30% 20%));
    border-radius: 12px; padding: 0.4rem;
    box-shadow: 0 16px 48px rgba(0,0,0,0.45);
    z-index: 200;
  }
  .account-menu[hidden] { display: none; }
  .account-head {
    display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.5rem 0.6rem 0.6rem; margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border, hsl(220 30% 20%));
  }
  .account-head-name {
    font-size: 0.85rem; font-weight: 600;
    color: var(--color-foreground, hsl(210 20% 94%));
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .account-head-email {
    font-size: 0.72rem; color: var(--color-muted-foreground, hsl(215 20% 55%));
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .account-item {
    display: flex; align-items: center; gap: 0.55rem; width: 100%;
    padding: 0.5rem 0.6rem; border-radius: 8px;
    background: transparent; border: none; cursor: pointer;
    font-size: 0.82rem; font-family: inherit; text-align: left;
    color: var(--color-foreground, hsl(210 20% 90%)); text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .account-item :global(svg) { color: hsl(215 20% 60%); flex-shrink: 0; }
  .account-item:hover { background: rgba(255,255,255,0.07); }
  :global(html.light) .account-item:hover { background: rgba(0,0,0,0.05); }
  .account-item--danger { color: hsl(0 72% 65%); }
  .account-item--danger :global(svg) { color: hsl(0 72% 60%); }
  .account-item--danger:hover { background: rgba(220,38,38,0.12); }

  .account-theme {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.35rem 0.6rem; gap: 0.5rem;
  }
  .account-theme-label {
    font-size: 0.82rem; color: var(--color-foreground, hsl(210 20% 90%));
  }
  .account-sep {
    height: 1px; margin: 0.3rem 0.2rem;
    background: var(--color-border, hsl(220 30% 20%));
  }

  /* Login */
  .btn-login {
    padding: 0.35rem 0.8rem; border-radius: 7px;
    background: var(--color-primary); color: #fff;
    text-decoration: none; font-size: 0.8rem; font-weight: 600;
  }

  /* Accent line */
  .topbar-accent {
    height: 2px;
    background: linear-gradient(90deg, hsl(35 100% 48%) 0%, hsl(216 85% 50%) 100%);
  }

  /* Responsive */
  @media (max-width: 768px) {
    /* En mobile el trigger queda compacto (avatar + caret); el nombre se oculta.
       .user-badge sigue visible — la barra de acciones depende de él. */
    .user-name { display: none; }
    .topbar-center { display: none; }
  }
  @media (max-width: 480px) {
    .btn-action { display: none; }
  }
</style>
