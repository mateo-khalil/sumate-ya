---
/**
 * /equipos — Lista de equipos del usuario (como capitán y como miembro).
 *
 * Decision Context:
 * - SSR porque requiere auth; los equipos son del usuario autenticado.
 * - Si no está autenticado redirige a /login.
 * - El formulario de creación está en una isla React (CreateTeamDialog) para
 *   poder llamar /api/graphql-auth sin exponer credenciales en el cliente.
 * - Previously fixed bugs: none relevant.
 */
export const prerender = false;

import { Users, Shield, ChevronRight } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/shared/Topbar.astro';
import { CreateTeamDialog } from '../components/teams/CreateTeamDialog';
import { MyInvitationsList } from '../components/teams/MyInvitationsList';
import { MY_TEAMS, type TeamData } from '../graphql/operations/teams';
import { readAccessToken } from '../lib/auth';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?redirect=/equipos');

const accessToken = readAccessToken(Astro.cookies) ?? '';
const backendUrl =
  import.meta.env.PRIVATE_BACKEND_URL ||
  (typeof process !== 'undefined' ? process.env.PRIVATE_BACKEND_URL : undefined) ||
  'http://localhost:4000';

let teams: TeamData[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(`${backendUrl}/graphql`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${accessToken}` },
    body: JSON.stringify({ query: MY_TEAMS }),
  });
  const json = await res.json() as { data?: { myTeams: TeamData[] }; errors?: { message: string }[] };
  if (json.errors?.length) fetchError = json.errors[0].message;
  else teams = json.data?.myTeams ?? [];
} catch {
  fetchError = 'No se pudo cargar tus equipos';
}

const FORMAT_LABEL: Record<string, string> = {
  FIVE_VS_FIVE: '5 vs 5', SEVEN_VS_SEVEN: '7 vs 7',
  TEN_VS_TEN: '10 vs 10', ELEVEN_VS_ELEVEN: '11 vs 11',
};

const userId = user!.id;
function myRole(team: TeamData): 'CAPTAIN' | 'MEMBER' {
  return team.captainId === userId ? 'CAPTAIN' : 'MEMBER';
}
---

<Layout title="Mis Equipos">
  <div class="page-shell">
    <Topbar user={user} />
    <div class="page-container">
    <!-- Header -->
    <div class="page-header">
      <div class="header-title">
        <Users size={28} strokeWidth={2} aria-hidden="true" />
        <h1>Mis Equipos</h1>
      </div>
      <CreateTeamDialog client:load />
    </div>

    {/* Invitaciones pendientes recibidas */}
    <MyInvitationsList client:load />

    {fetchError && (
      <div class="error-banner" role="alert">{fetchError}</div>
    )}

    {!fetchError && teams.length === 0 && (
      <div class="empty-state">
        <Users size={48} strokeWidth={1.5} aria-hidden="true" style={{ margin: '0 auto 1rem', display: 'block', opacity: 0.4 }} />
        <p>Todavía no sos parte de ningún equipo.</p>
        <p class="empty-sub">Creá un equipo o esperá una invitación de un capitán.</p>
      </div>
    )}

    {teams.length > 0 && (
      <div class="teams-grid">
        {teams.map(team => {
          const role = myRole(team);
          const isCaptain = role === 'CAPTAIN';
          return (
            <a href={`/equipos/${team.id}`} class="team-card">
              <div class="team-card-top">
                <div class="team-logo">
                  {team.logoUrl
                    ? <img src={team.logoUrl} alt={`Logo de ${team.name}`} class="logo-img" />
                    : <Shield size={28} strokeWidth={1.5} aria-hidden="true" />
                  }
                </div>
                <div class="team-info">
                  <h2 class="team-name">{team.name}</h2>
                  <span class="team-format">{FORMAT_LABEL[team.format] ?? team.format}</span>
                </div>
                <ChevronRight size={20} strokeWidth={2} aria-hidden="true" style={{ color: 'var(--color-muted-foreground)', flexShrink: 0 }} />
              </div>
              <div class="team-card-bottom">
                <span class="member-count">
                  <Users size={14} strokeWidth={2} aria-hidden="true" />
                  {team.memberCount} {team.memberCount === 1 ? 'jugador' : 'jugadores'}
                </span>
                <span class={`role-badge ${isCaptain ? 'role-captain' : 'role-member'}`}>
                  {isCaptain
                    ? <><Shield size={12} strokeWidth={2} aria-hidden="true" /> Capitán</>
                    : 'Miembro'
                  }
                </span>
              </div>
            </a>
          );
        })}
      </div>
    )}
    </div>
  </div>
</Layout>

<style>
  .page-shell { min-height: 100vh; display: flex; flex-direction: column; }
  .page-container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; flex: 1; }

  .page-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 2rem;
  }
  .header-title {
    display: flex; align-items: center; gap: 0.75rem;
    color: var(--color-foreground);
  }
  .header-title h1 { font-size: 1.75rem; font-weight: 700; margin: 0; }

  .error-banner {
    background: hsl(0 60% 15%); border: 1px solid hsl(0 72% 40%);
    color: hsl(0 80% 70%); padding: 0.75rem 1rem; border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .empty-state {
    text-align: center; padding: 4rem 1rem;
    color: var(--color-muted-foreground);
  }
  .empty-icon { margin: 0 auto 1rem; display: block; opacity: 0.4; }
  .empty-state p { margin: 0.25rem 0; }
  .empty-sub { font-size: 0.875rem; opacity: 0.8; }

  .teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .team-card {
    background: var(--color-card); border: 1px solid var(--color-border);
    border-radius: 12px; padding: 1.25rem; text-decoration: none;
    color: var(--color-foreground); transition: border-color 0.2s, transform 0.15s;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .team-card:hover { border-color: var(--color-primary); transform: translateY(-2px); }

  .team-card-top { display: flex; align-items: center; gap: 1rem; }
  .team-logo {
    width: 48px; height: 48px; border-radius: 8px;
    background: var(--color-muted); display: flex; align-items: center;
    justify-content: center; flex-shrink: 0; color: var(--color-muted-foreground);
    overflow: hidden;
  }
  .logo-img { width: 100%; height: 100%; object-fit: cover; }
  .team-info { flex: 1; min-width: 0; }
  .team-name {
    font-size: 1rem; font-weight: 600; margin: 0; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .team-format { font-size: 0.8rem; color: var(--color-muted-foreground); }
  .chevron { color: var(--color-muted-foreground); flex-shrink: 0; }

  .team-card-bottom { display: flex; align-items: center; justify-content: space-between; }
  .member-count {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.8rem; color: var(--color-muted-foreground);
  }
  .role-badge {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .role-captain {
    background: hsl(35 100% 20%); color: hsl(35 100% 65%);
  }
  .role-member {
    background: hsl(216 60% 18%); color: hsl(216 80% 65%);
  }
</style>
