---
/**
 * Login Page (SSR)
 *
 * Decision Context:
 * - Why SSR: Handles POST form submission server-side and reads/writes auth cookies.
 * - Pattern: Progressive enhancement — works without JS. POST + redirect, no client fetch.
 * - Security: Frontend does not call Supabase directly; credentials are posted to backend auth.
 *   HttpOnly cookies store tokens for subsequent SSR middleware checks.
 * - Back-button "logout" fix: this SSR page is restored from the browser bfcache when the user
 *   presses Back after logging in, so the SSR redirect below never re-runs and the user sees the
 *   stale login form (looked like a logout). The pageshow handler at the bottom forces a reload
 *   on bfcache restore so an authenticated user is bounced to their panel instead of the form.
 * - Resilience: an invalid/expired access token now triggers a silent refresh (mirroring the
 *   middleware) BEFORE clearing cookies, so a transient session-validation failure no longer
 *   destroys the refresh token and logs the user out for real.
 * - Password reveal toggle: a button inside the password field switches input type between
 *   password/text. It is progressive enhancement (the field works as a normal password input
 *   without JS) and is type="button" so it never submits the form. aria-pressed/aria-label and
 *   the Eye/EyeOff icon swap keep the state accessible. Both icons are rendered statically by
 *   Astro; the client script toggles their `hidden` attribute instead of re-rendering.
 * - Previously fixed bugs:
 *   - Back button after login showed the cached login form (bfcache) — fixed via pageshow reload.
 *   - A failed getSessionFromBackend() unconditionally cleared BOTH cookies, logging the user out
 *     on any transient backend hiccup — fixed by attempting refreshFromBackend() first.
 *   - Invisible input text in light mode / Safari: the scoped `.field input` rule outranks the
 *     global `html.light .field input` override, so the input kept the dark-theme near-white text
 *     on the light card. Fixed by coloring inputs with `var(--color-foreground)` (auto-flips per
 *     theme) plus explicit `-webkit-text-fill-color` (Safari prioritizes it, incl. on autofill).
 */
export const prerender = false;

import { Volleyball, Check, TriangleAlert, Eye, EyeOff } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import {
  ACCESS_TOKEN_COOKIE,
  ACCESS_TOKEN_MAX_AGE,
  REFRESH_TOKEN_COOKIE,
  REFRESH_TOKEN_MAX_AGE,
  clearAuthCookies,
  getAuthCookieOptions,
  getRoleRedirect,
  getSessionFromBackend,
  isProduction,
  loginWithBackend,
  readAccessToken,
  readRefreshToken,
  refreshFromBackend,
} from '../lib/auth';

const accessToken = readAccessToken(Astro.cookies);

if (accessToken) {
  const user = await getSessionFromBackend(accessToken);
  if (user) {
    return Astro.redirect(getRoleRedirect(user.role));
  }

  // Access token presente pero inválido (p.ej. expirado). Antes de cerrar la sesión,
  // intentar un refresh silencioso igual que el middleware (P3): así una validación
  // fallida transitoria no borra el refresh token ni desloguea al usuario.
  const refreshToken = readRefreshToken(Astro.cookies);
  if (refreshToken) {
    try {
      const result = await refreshFromBackend(refreshToken);
      const isProd = isProduction(Astro.request);
      Astro.cookies.set(
        ACCESS_TOKEN_COOKIE,
        result.accessToken,
        getAuthCookieOptions(isProd, ACCESS_TOKEN_MAX_AGE),
      );
      Astro.cookies.set(
        REFRESH_TOKEN_COOKIE,
        result.refreshToken,
        getAuthCookieOptions(isProd, REFRESH_TOKEN_MAX_AGE),
      );
      return Astro.redirect(getRoleRedirect(result.user.role));
    } catch {
      clearAuthCookies(Astro.cookies);
    }
  } else {
    clearAuthCookies(Astro.cookies);
  }
}

// --- Mensaje de registro exitoso ---
const registered = Astro.url.searchParams.get('registered') === '1';

// --- Manejo del formulario POST ---
let errorMessage = '';
let emailValue = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  emailValue = formData.get('email')?.toString() ?? '';
  const password = formData.get('password')?.toString() ?? '';

  if (!emailValue || !password) {
    errorMessage = 'Completá todos los campos.';
  } else {
    try {
      const result = await loginWithBackend(emailValue, password);
      const isProd = isProduction(Astro.request);

      // Separate maxAge — short-lived access token, long-lived refresh token.
      Astro.cookies.set(
        ACCESS_TOKEN_COOKIE,
        result.accessToken,
        getAuthCookieOptions(isProd, ACCESS_TOKEN_MAX_AGE),
      );
      Astro.cookies.set(
        REFRESH_TOKEN_COOKIE,
        result.refreshToken,
        getAuthCookieOptions(isProd, REFRESH_TOKEN_MAX_AGE),
      );

      return Astro.redirect(getRoleRedirect(result.user.role));
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Authentication failed';

      if (message.includes('Email not confirmed') || message.includes('email_not_confirmed')) {
        errorMessage =
          'Debés confirmar tu email antes de iniciar sesión. Revisá tu casilla de correo.';
      } else if (
        message.includes('Invalid login credentials') ||
        message.includes('invalid_credentials')
      ) {
        errorMessage = 'Email o contraseña incorrectos.';
      } else {
        errorMessage = 'Ocurrió un error al iniciar sesión. Intentá de nuevo.';
      }
    }
  }
}
---

<Layout title="Iniciar sesión — Sumate Ya">
  <main class="login-wrapper">
    <!-- Stadium arc decoration -->
    <div class="stadium-arc" aria-hidden="true"></div>

    <div class="login-card">
      <div class="login-header">
        <div class="brand-lockup">
          <span class="brand-icon"><Volleyball size={28} strokeWidth={2} aria-hidden="true" /></span>
          <h1 class="brand-name">SUMATE YA</h1>
        </div>
        <p class="login-subtitle">Iniciá sesión para continuar</p>
      </div>

      {
        registered && (
          <div class="success-banner" role="status">
            <span class="success-icon"><Check size={16} strokeWidth={2.5} aria-hidden="true" /></span>
            <span>Registro exitoso. Ya podés iniciar sesión.</span>
          </div>
        )
      }

      {
        errorMessage && (
          <div class="error-banner" role="alert">
            <span class="error-icon"><TriangleAlert size={16} strokeWidth={2.25} aria-hidden="true" /></span>
            <span>{errorMessage}</span>
          </div>
        )
      }

      <form method="POST" novalidate class="login-form">
        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            value={emailValue}
            autocomplete="email"
            required
            placeholder="tu@email.com"
          />
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <div class="password-wrap">
            <input
              id="password"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              placeholder="••••••••"
            />
            <button
              type="button"
              id="toggle-password"
              class="password-toggle"
              aria-label="Mostrar contraseña"
              aria-pressed="false"
              aria-controls="password"
            >
              <span class="password-toggle-icon" data-icon="show">
                <Eye size={18} strokeWidth={2} aria-hidden="true" />
              </span>
              <span class="password-toggle-icon" data-icon="hide" hidden>
                <EyeOff size={18} strokeWidth={2} aria-hidden="true" />
              </span>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-submit">INGRESAR</button>
      </form>

      <p class="register-link">
        ¿Sos un club? <a href="/registro-club">Registrate acá</a>
      </p>
      <p class="register-link">
        ¿Sos jugador? <a href="/registro-jugador">Registrate acá</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  // bfcache fix (back-button "logout"): cuando el usuario presiona "atrás" tras loguearse,
  // el navegador restaura esta página de login desde el back/forward cache (bfcache) y NO
  // vuelve a ejecutar el SSR, mostrando el formulario en vez de redirigir al panel. Forzar
  // un reload en la restauración desde bfcache hace que el SSR corra de nuevo y mande al
  // usuario autenticado a su panel.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      window.location.reload();
    }
  });

  // Toggle de visibilidad de la contraseña: progressive enhancement — sin JS el campo
  // sigue siendo un input type="password" normal. Al activar, cambia el type del input,
  // intercambia los iconos Eye/EyeOff y actualiza aria-pressed/aria-label para lectores.
  const toggleBtn = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('password');
  if (toggleBtn instanceof HTMLButtonElement && passwordInput instanceof HTMLInputElement) {
    const showIcon = toggleBtn.querySelector('[data-icon="show"]');
    const hideIcon = toggleBtn.querySelector('[data-icon="hide"]');
    toggleBtn.addEventListener('click', () => {
      const reveal = passwordInput.type === 'password';
      passwordInput.type = reveal ? 'text' : 'password';
      toggleBtn.setAttribute('aria-pressed', String(reveal));
      toggleBtn.setAttribute('aria-label', reveal ? 'Ocultar contraseña' : 'Mostrar contraseña');
      showIcon?.toggleAttribute('hidden', reveal);
      hideIcon?.toggleAttribute('hidden', !reveal);
      passwordInput.focus();
    });
  }
</script>

<style>
  /* ---- Layout ---- */
  .login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* ---- Stadium arc decoration ---- */
  .stadium-arc {
    position: fixed;
    bottom: -30vw;
    left: 50%;
    transform: translateX(-50%);
    width: 90vw;
    height: 45vw;
    border: 2px solid rgba(246, 164, 0, 0.12);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    pointer-events: none;
  }

  .stadium-arc::before {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 60%;
    border: 1px solid rgba(27, 105, 224, 0.10);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }

  /* ---- Card (glassmorphism) ---- */
  .login-card {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    padding: 2.75rem 2.25rem;
    width: 100%;
    max-width: 420px;
    box-shadow:
      0 0 0 1px rgba(246, 164, 0, 0.06),
      0 24px 64px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    position: relative;
    z-index: 1;
  }

  /* Orange top stripe */
  .login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    height: 3px;
    background: linear-gradient(90deg, hsl(35 100% 48%), hsl(216 85% 45%));
    border-radius: 0 0 3px 3px;
  }

  /* ---- Brand header ---- */
  .login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .brand-icon {
    line-height: 1;
    display: inline-flex;
    color: hsl(35 100% 55%);
  }
  .success-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
  }

  .brand-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: #ffffff;
    margin: 0;
    line-height: 1;
  }

  .login-subtitle {
    margin: 0;
    color: hsl(215 20% 55%);
    font-size: 0.875rem;
    font-family: 'Barlow', sans-serif;
    letter-spacing: 0.01em;
  }

  /* ---- Error banner ---- */
  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.35);
    color: hsl(0 72% 70%);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    font-family: 'Barlow', sans-serif;
  }

  .error-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
  }

  /* ---- Form fields ---- */
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: hsl(215 20% 65%);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: 'Barlow Condensed', sans-serif;
  }

  /* Text color uses the theme token (auto-flips in light mode) instead of a hardcoded
     dark-theme value. The scoped selector here outranks the global `html.light .field
     input` override, so without the token the input kept the dark-theme near-white text
     and became invisible on the light card. `-webkit-text-fill-color` is set explicitly
     because Safari prioritizes it over `color` (and applies it on autofill), which made
     the typed/autofilled text invisible there even when `color` was correct. */
  .field input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: 'Barlow', sans-serif;
    color: var(--color-foreground);
    -webkit-text-fill-color: var(--color-foreground);
    caret-color: var(--color-foreground);
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    outline: none;
    width: 100%;
  }

  /* ---- Password field with reveal toggle ---- */
  .password-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  /* Reserve room on the right so typed text never slides under the toggle button. */
  .password-wrap input {
    padding-right: 3rem;
  }
  .password-toggle {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--color-muted-foreground);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .password-toggle:hover {
    color: var(--color-foreground);
    background: rgba(255, 255, 255, 0.06);
  }
  .password-toggle:focus-visible {
    outline: none;
    color: var(--color-foreground);
    box-shadow: 0 0 0 2px rgba(27, 105, 224, 0.45);
  }
  .password-toggle-icon {
    display: inline-flex;
    line-height: 0;
  }
  :global(html.light) .password-toggle:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .field input::placeholder {
    color: var(--color-muted-foreground);
    -webkit-text-fill-color: var(--color-muted-foreground);
    opacity: 1;
  }

  .field input:focus {
    border-color: hsl(216 85% 55%);
    background: rgba(27, 105, 224, 0.08);
    box-shadow: 0 0 0 3px rgba(27, 105, 224, 0.2);
  }

  /* Safari/Chrome autofill: force legible text in both themes and stop the browser from
     repainting its own (near-white) autofill text color over ours. The 9999s transition
     is the standard hack to suppress the autofill background flash without !important. */
  .field input:-webkit-autofill,
  .field input:-webkit-autofill:hover,
  .field input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-foreground);
    caret-color: var(--color-foreground);
    transition: background-color 9999s ease-in-out 0s, border-color 0.15s, box-shadow 0.15s;
  }

  /* Light theme: the scoped rules above win over the global `html.light .field input`
     override, so restore the light-card field surface and focus here at the same scope.
     Previously fixed bugs: text was invisible (white-on-white) in light mode because
     background resolved to near-transparent and -webkit-text-fill-color wasn't overridden.
     Fix: solid visible background + explicit color + -webkit-text-fill-color for Safari. */
  :global(html.light) .field input {
    background: hsl(210 20% 94%);
    border-color: rgba(0, 0, 0, 0.15);
    color: hsl(220 72% 10%);
    -webkit-text-fill-color: hsl(220 72% 10%);
  }
  :global(html.light) .field input::placeholder {
    color: hsl(215 20% 52%);
    -webkit-text-fill-color: hsl(215 20% 52%);
  }
  :global(html.light) .field input:focus {
    background: white;
    border-color: hsl(35 100% 44%);
    box-shadow: 0 0 0 3px hsl(35 100% 44% / 0.15);
  }

  /* ---- Submit button ---- */
  .btn-submit {
    margin-top: 0.5rem;
    padding: 0.875rem;
    background: linear-gradient(135deg, hsl(35 100% 48%), hsl(35 100% 42%));
    color: #fff;
    border: none;
    border-radius: 8px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: transform 0.1s, box-shadow 0.15s, filter 0.15s;
    box-shadow: 0 4px 20px rgba(246, 164, 0, 0.35);
    position: relative;
    overflow: hidden;
  }

  .btn-submit::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0.1), transparent);
    pointer-events: none;
  }

  .btn-submit:hover {
    filter: brightness(1.08);
    box-shadow: 0 6px 28px rgba(246, 164, 0, 0.5);
    transform: translateY(-1px);
  }

  .btn-submit:active {
    transform: scale(0.98) translateY(0);
    box-shadow: 0 2px 12px rgba(246, 164, 0, 0.3);
  }

  /* ---- Success banner ---- */
  .success-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: hsl(142 70% 60%);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
    font-family: 'Barlow', sans-serif;
  }

  /* ---- Register link ---- */
  .register-link {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.875rem;
    font-family: 'Barlow', sans-serif;
    color: hsl(215 20% 50%);
  }

  .register-link:first-of-type {
    margin-top: 1.25rem;
  }

  .register-link a {
    color: hsl(35 100% 55%);
    text-decoration: none;
    font-weight: 600;
  }

  .register-link a:hover {
    text-decoration: underline;
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 480px) {
    .login-card {
      padding: 2rem 1.25rem;
      border-radius: 12px;
    }
    .login-wrapper { padding: 1rem; }
  }
</style>
