---
/**
 * /panel-club/configuracion — Ajustes de cuenta para el administrador de club.
 *
 * Decision Context:
 * - Rol exclusivo club_admin: misma protección que dashboard.astro.
 * - ChangePasswordForm es role-agnostic (llama al backend /api/auth/change-password
 *   que solo necesita el JWT del usuario activo, sin importar el rol).
 * - Layout idéntico al dashboard (ClubTopbar + main full-width) para coherencia
 *   dentro del panel de administración.
 * - La sección de privacidad de PrivacySettingsContainer es específica de jugadores
 *   (showStats, showPosition, etc.) y no aplica a club_admin, por eso se omite.
 * - Foto del Club: sección agregada para cargar la imagen de perfil del club. Consulta
 *   `clubDashboard { club { imageUrl } }` server-side para mostrar la imagen actual y pasa
 *   `currentImageUrl` como prop al island ClubImageUpload. El upload va por el proxy Astro
 *   `/api/club/image` → backend `/api/club/image` → clubImageService → avatars bucket bajo
 *   `{ownerId}/club-{clubId}-image-{ts}.ext` para satisfacer la policy de Storage existente.
 * - Previously fixed bugs: none relevant.
 */
export const prerender = false;

import { Camera, KeyRound, ShieldCheck, User, Bell } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import ClubTopbar from '../../components/panel-club/ClubTopbar.astro';
import ChangePasswordForm from '../../components/settings/ChangePasswordForm.tsx';
import NotificationPreferencesForm from '../../components/settings/NotificationPreferencesForm.tsx';
import ClubImageUpload from '../../components/club/ClubImageUpload.tsx';
import { readAccessToken } from '../../lib/auth.js';
import {
  GET_MY_NOTIFICATION_PREFERENCES,
  type NotificationPreferences,
} from '../../graphql/operations/notifications';

const user = Astro.locals.user;
if (!user || user.role !== 'club_admin') {
  return Astro.redirect('/login?reason=role-required');
}

const accessToken = readAccessToken(Astro.cookies) ?? '';
const backendUrl = import.meta.env.PRIVATE_BACKEND_URL || 'http://localhost:4000';
const graphqlUrl =
  import.meta.env.PUBLIC_GRAPHQL_URL || process.env.PUBLIC_GRAPHQL_URL || `${backendUrl}/graphql`;

// Fetch current club imageUrl for the photo upload section
let clubImageUrl: string | null = null;
if (accessToken) {
  try {
    const res = await fetch(graphqlUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${accessToken}` },
      body: JSON.stringify({ query: '{ clubDashboard { club { id imageUrl } } }' }),
    });
    const json = (await res.json().catch(() => null)) as
      | { data?: { clubDashboard?: { club?: { imageUrl?: string | null } } } }
      | null;
    clubImageUrl = json?.data?.clubDashboard?.club?.imageUrl ?? null;
  } catch {
    // Graceful degradation: component renders without current image.
  }
}

// Notification preferences shared with players — club admins receive notifications too.
const DEFAULT_NOTIF_PREFS: NotificationPreferences = {
  matchActivity: true,
  matchUpdates: true,
  matchResults: true,
  invitations: true,
};
let notifPrefs: NotificationPreferences = DEFAULT_NOTIF_PREFS;

if (accessToken) {
  try {
    const res = await fetch(graphqlUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${accessToken}` },
      body: JSON.stringify({ query: GET_MY_NOTIFICATION_PREFERENCES }),
    });
    const json = (await res.json().catch(() => null)) as
      | { data?: { myNotificationPreferences: NotificationPreferences } }
      | null;
    if (json?.data?.myNotificationPreferences) {
      notifPrefs = json.data.myNotificationPreferences;
    }
  } catch {
    // Graceful degradation: keep defaults; the form can still save.
  }
}
---

<Layout title="Configuración de Cuenta — Panel de Club — Sumate Ya">
  <div class="app-shell">
    <ClubTopbar user={user} currentPath={Astro.url.pathname} />

    <div class="page-layout">
      <main class="page-content">
        <header class="section-header">
          <div class="section-label">CUENTA</div>
          <h1 class="section-title">Configuración</h1>
          <p class="section-sub">Administrá la seguridad y los datos de tu cuenta de club</p>
        </header>

        <div class="settings-layout">

          <!-- Sidebar de navegación interna -->
          <nav class="settings-nav" aria-label="Secciones">
            <a href="#foto-club" class="settings-nav-item settings-nav-item--active">
              <Camera size={15} strokeWidth={2} aria-hidden="true" />
              Foto del Club
            </a>
            <a href="#cuenta" class="settings-nav-item">
              <User size={15} strokeWidth={2} aria-hidden="true" />
              Mi Cuenta
            </a>
            <a href="#seguridad" class="settings-nav-item">
              <ShieldCheck size={15} strokeWidth={2} aria-hidden="true" />
              Seguridad
            </a>
            <a href="#notificaciones" class="settings-nav-item">
              <Bell size={15} strokeWidth={2} aria-hidden="true" />
              Notificaciones
            </a>
          </nav>

          <!-- Panel de contenido -->
          <div class="settings-panel">

            <!-- Foto del Club -->
            <section id="foto-club" class="settings-section">
              <div class="settings-section-header">
                <div class="icon-wrap">
                  <Camera size={18} strokeWidth={2} aria-hidden="true" />
                </div>
                <div>
                  <h2 class="settings-section-title">Foto del Club</h2>
                  <p class="settings-section-sub">
                    Imagen de perfil del club visible en partidos y torneos
                  </p>
                </div>
              </div>

              <ClubImageUpload
                client:load
                currentImageUrl={clubImageUrl}
              />
            </section>

            <div class="section-divider"></div>

            <!-- Mi Cuenta -->
            <section id="cuenta" class="settings-section">
              <div class="settings-section-header">
                <div class="icon-wrap">
                  <User size={18} strokeWidth={2} aria-hidden="true" />
                </div>
                <div>
                  <h2 class="settings-section-title">Mi Cuenta</h2>
                  <p class="settings-section-sub">
                    Información de tu cuenta de administrador de club
                  </p>
                </div>
              </div>

              <div class="account-info-card">
                <div class="account-row">
                  <span class="account-label">Email</span>
                  <span class="account-value">{user.email}</span>
                </div>
                <div class="account-row">
                  <span class="account-label">Nombre</span>
                  <span class="account-value">{user.displayName || '—'}</span>
                </div>
                <div class="account-row">
                  <span class="account-label">Rol</span>
                  <span class="account-value account-role">Administrador de Club</span>
                </div>
              </div>
            </section>

            <div class="section-divider"></div>

            <!-- Seguridad -->
            <section id="seguridad" class="settings-section">
              <div class="settings-section-header">
                <div class="icon-wrap">
                  <KeyRound size={18} strokeWidth={2} aria-hidden="true" />
                </div>
                <div>
                  <h2 class="settings-section-title">Seguridad</h2>
                  <p class="settings-section-sub">
                    Actualizá tu contraseña. Usamos tu sesión activa para verificar el cambio.
                  </p>
                </div>
              </div>

              <ChangePasswordForm
                client:load
                accessToken={accessToken}
                backendUrl={backendUrl}
              />
            </section>

            <div class="section-divider"></div>

            <!-- Notificaciones -->
            <section id="notificaciones" class="settings-section">
              <div class="settings-section-header">
                <div class="icon-wrap">
                  <Bell size={18} strokeWidth={2} aria-hidden="true" />
                </div>
                <div>
                  <h2 class="settings-section-title">Notificaciones</h2>
                  <p class="settings-section-sub">
                    Elegí qué eventos te avisamos desde la campana
                  </p>
                </div>
              </div>

              <NotificationPreferencesForm
                client:load
                initialPreferences={notifPrefs}
                accessToken={accessToken}
                backendUrl={backendUrl}
              />
            </section>

          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  // Highlight settings-nav-item al hacer scroll hacia las secciones
  const sections = document.querySelectorAll('.settings-section');
  const navItems = document.querySelectorAll('.settings-nav-item:not(.settings-nav-item--disabled)');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navItems.forEach(item => {
            const href = item.getAttribute('href');
            if (href === `#${id}`) {
              item.classList.add('settings-nav-item--active');
            } else {
              item.classList.remove('settings-nav-item--active');
            }
          });
        }
      });
    },
    { threshold: 0.5 }
  );
  sections.forEach(s => observer.observe(s));
</script>

<style>
  .app-shell { min-height: 100vh; display: flex; flex-direction: column; }

  /* ── Page layout ── */
  .page-layout { flex:1; display:block; max-width:1280px; width:100%; margin:0 auto; padding:2rem 1.25rem; }
  .page-content { width:100%; min-width:0; }
  .section-header { margin-bottom:1.75rem; padding-bottom:1rem; border-bottom:1px solid rgba(255,255,255,.06); }
  .section-label { font-family:'Barlow Condensed',sans-serif; font-size:.75rem; font-weight:700; letter-spacing:.2em; color:hsl(42 100% 55%); text-transform:uppercase; margin-bottom:.4rem; }
  .section-title { font-family:'Bebas Neue',sans-serif; font-size:clamp(1.6rem,5vw,2.2rem); font-weight:400; letter-spacing:.04em; color:#fff; margin:0 0 .3rem; line-height:1; }
  .section-sub { margin:0; color:hsl(215 20% 50%); font-size:.875rem; }

  /* ── Settings layout ── */
  .settings-layout { display:grid; grid-template-columns:200px 1fr; gap:2rem; }
  @media (max-width:900px) { .settings-layout { grid-template-columns:1fr; } }

  /* Settings nav */
  .settings-nav { display:flex; flex-direction:column; gap:3px; }
  .settings-nav-item {
    display:flex; align-items:center; gap:.55rem; padding:.5rem .75rem;
    border-radius:8px; font-size:.86rem; font-weight:500; color:hsl(215 20% 55%);
    text-decoration:none; border:1px solid transparent; transition:background .12s,color .12s;
    cursor:pointer;
  }
  .settings-nav-item:hover:not(.settings-nav-item--disabled) { background:rgba(255,255,255,.06); color:hsl(210 20% 82%); }
  .settings-nav-item--active { background:rgba(246,164,0,.1); color:hsl(42 100% 65%); border-color:rgba(246,164,0,.2); font-weight:600; }
  .settings-nav-item--disabled { opacity:.45; cursor:not-allowed; }
  .coming-pill { margin-left:auto; font-size:.62rem; font-weight:700; text-transform:uppercase; background:rgba(255,255,255,.06); color:hsl(215 20% 45%); border-radius:4px; padding:.1rem .35rem; }

  /* Settings panel */
  .settings-panel { display:flex; flex-direction:column; gap:2rem; }

  .settings-section { display:flex; flex-direction:column; gap:1.25rem; }
  .settings-section-header { display:flex; align-items:flex-start; gap:1rem; }
  .icon-wrap {
    width:38px; height:38px; border-radius:9px; flex-shrink:0;
    background:rgba(246,164,0,.1); border:1px solid rgba(246,164,0,.18);
    display:flex; align-items:center; justify-content:center; color:hsl(42 100% 65%);
  }
  .settings-section-title { font-family:'Barlow Condensed',sans-serif; font-size:1.1rem; font-weight:700; letter-spacing:.04em; color:#fff; margin:0 0 .2rem; }
  .settings-section-sub { margin:0; font-size:.82rem; color:hsl(215 20% 52%); }

  /* Account info card */
  .account-info-card { background:hsl(220 55% 11%); border:1px solid rgba(255,255,255,.07); border-radius:10px; overflow:hidden; }
  .account-row { display:flex; align-items:center; gap:1rem; padding:.75rem 1.1rem; border-bottom:1px solid rgba(255,255,255,.05); }
  .account-row:last-child { border-bottom:none; }
  .account-label { font-size:.78rem; font-weight:700; font-family:'Barlow Condensed',sans-serif; letter-spacing:.1em; text-transform:uppercase; color:hsl(215 20% 45%); min-width:80px; }
  .account-value { font-size:.875rem; color:hsl(210 20% 85%); }
  .account-role { color:hsl(42 100% 62%); font-weight:600; }

  /* Divider */
  .section-divider { height:1px; background:rgba(255,255,255,.06); }

  /* ── Club image upload island ── */
  :global(.club-img-upload) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 420px;
  }
  :global(.club-img-upload) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 420px;
  }

  :global(.club-img-preview-btn) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    border-radius: 10px;
    border: 2px dashed rgba(255,255,255,0.14);
    background: hsl(220 55% 11%);
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  :global(.club-img-preview-btn:not(.club-img-preview-btn--working):hover) {
    border-color: hsl(42 100% 55% / 0.5);
    background: hsl(220 55% 13%);
  }
  :global(.club-img-preview-btn--working) { cursor: not-allowed; }

  :global(.club-img-preview) {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  :global(.club-img-placeholder) {
    display: flex; flex-direction: column;
    align-items: center; gap: 0.5rem;
    color: hsl(215 20% 45%);
    font-size: 0.8rem; font-family: 'Barlow', sans-serif;
  }

  /* Upload overlay shown over the preview while working */
  :global(.club-img-overlay) {
    position: absolute; inset: 0;
    background: rgba(7,15,31,0.72);
    backdrop-filter: blur(4px);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 0.5rem;
    color: hsl(210 20% 88%);
    font-size: 0.82rem; font-family: 'Barlow', sans-serif;
    pointer-events: none;
  }

  @keyframes club-img-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  :global(.club-img-spinner) {
    animation: club-img-spin 1s linear infinite;
    color: hsl(42 100% 60%);
  }

  :global(.club-img-select-btn) {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.45rem 0.85rem; border-radius: 7px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.86rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    transition: background 0.12s, color 0.12s;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.07);
    color: hsl(210 20% 75%);
    user-select: none;
  }
  :global(.club-img-select-btn:not([aria-disabled="true"]):hover) {
    background: rgba(255,255,255,0.12);
    color: hsl(210 20% 90%);
  }

  :global(.club-img-status) {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.82rem; font-family: 'Barlow', sans-serif; margin: 0;
  }
  :global(.club-img-status--success) { color: hsl(142 72% 50%); }
  :global(.club-img-status--error)   { color: hsl(0 72% 65%); }

  :global(.club-img-hint) {
    font-size: 0.72rem; color: hsl(215 20% 38%);
    margin: 0; font-family: 'Barlow', sans-serif;
  }

  /* Light mode overrides */
  :global(html.light .club-img-preview-btn) {
    background: hsl(210 20% 96%); border-color: rgba(0,0,0,0.12);
  }
  :global(html.light .club-img-preview-btn:not(.club-img-preview-btn--working):hover) {
    background: hsl(210 20% 93%); border-color: hsl(35 80% 60% / 0.5);
  }
  :global(html.light .club-img-placeholder) { color: hsl(215 16% 52%); }
  :global(html.light .club-img-overlay) { background: rgba(255,255,255,0.8); color: hsl(220 20% 30%); }
  :global(html.light .club-img-select-btn) {
    background: hsl(0 0% 97%); color: hsl(220 20% 35%); border-color: rgba(0,0,0,0.12);
  }
  :global(html.light .club-img-select-btn:not([aria-disabled="true"]):hover) {
    background: hsl(0 0% 93%); color: hsl(220 20% 18%);
  }
  :global(html.light .club-img-hint) { color: hsl(215 16% 50%); }

  /* ── Tema claro ── */
  :global(html.light) .section-title { color:hsl(220 72% 10%); }
  :global(html.light) .section-sub { color:hsl(215 16% 38%); }
  :global(html.light) .section-header { border-bottom-color:rgba(0,0,0,.07); }
  :global(html.light) .settings-nav-item { color:hsl(220 16% 42%); }
  :global(html.light) .settings-nav-item:hover:not(.settings-nav-item--disabled) { background:rgba(0,0,0,.05); color:hsl(220 72% 10%); }
  :global(html.light) .settings-nav-item--active { background:hsl(35 100% 92%); color:hsl(35 100% 30%); border-color:hsl(35 80% 78%); }
  :global(html.light) .account-info-card { background:hsl(0 0% 100%); border-color:rgba(0,0,0,.08); }
  :global(html.light) .account-row { border-bottom-color:rgba(0,0,0,.05); }
  :global(html.light) .account-value { color:hsl(220 20% 25%); }
  :global(html.light) .account-role { color:hsl(35 100% 32%); }
  :global(html.light) .section-divider { background:rgba(0,0,0,.06); }
  :global(html.light) .icon-wrap { background:hsl(35 100% 95%); border-color:hsl(35 80% 80%); color:hsl(35 100% 38%); }

  @media (max-width:767px) {
    .page-layout { padding:1rem; }
  }
</style>
