---
/**
 * /torneos — Listado dedicado de torneos disponibles.
 *
 * Decision Context:
 * - Mantiene la página de torneos como vista dedicada (el hub unificado está en /partidos).
 * - Usa el Topbar compartido con flechas de historial para consistencia de navegación.
 * - Previously fixed bugs: none relevant.
 */
export const prerender = false;

import { Trophy } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import Topbar from '../../components/shared/Topbar.astro';
import { TournamentsView } from '../../components/tournaments/TournamentsView';
---

<Layout title="Torneos Disponibles — Sumate Ya">
  <div class="app-shell">
    <Topbar user={Astro.locals.user} />

    <main class="page-content">
      <header class="section-header">
        <div class="section-label">
          <Trophy size={14} strokeWidth={2} aria-hidden="true" style={{ display: 'inline', verticalAlign: 'middle' }} />
          TORNEOS
        </div>
        <h1 class="section-title">Torneos Disponibles</h1>
        <p class="section-sub">Encontrá una copa abierta y anotá tu equipo</p>
      </header>

      <TournamentsView client:visible isAuthenticated={!!Astro.locals.user} />
    </main>
  </div>
</Layout>

<style>
  .app-shell { min-height: 100vh; display: flex; flex-direction: column; }
  .page-content {
    flex: 1; max-width: 1200px; width: 100%;
    margin: 0 auto; padding: 2.5rem 1.25rem;
  }
  .section-header { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .section-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em;
    color: hsl(42 100% 58%); text-transform: uppercase; margin-bottom: 0.4rem;
  }
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    letter-spacing: 0.04em; color: #fff; margin: 0 0 0.3rem; line-height: 1;
  }
  .section-sub { margin: 0; color: hsl(215 20% 50%); font-size: 0.875rem; }
  @media (max-width: 767px) {
    .page-content { padding: 1.25rem 1rem; }
    .section-header { margin-bottom: 1.25rem; }
  }
</style>
